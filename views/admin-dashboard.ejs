<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - APSS Cave Experience</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #f4f7f6;
      color: #333;
      padding: 30px;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    h1 {
      color: #2c3e50;
    }

    .btn-logout {
      background-color: #e74c3c;
      color: white;
      padding: 8px 16px;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 600;
      transition: background-color 0.2s;
    }

    .btn-logout:hover {
      background-color: #c0392b;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      margin-bottom: 30px;
    }

    .card h2 {
      color: #34495e;
      font-size: 1.3rem;
    }

    .card-header-action {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #ecf0f1;
      padding-bottom: 12px;
      margin-bottom: 15px;
    }

    .btn-export {
      background-color: #27ae60;
      color: white;
      padding: 8px 16px;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: background-color 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-export:hover {
      background-color: #219653;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 6px;
      font-weight: 600;
      color: #444;
    }

    .form-group input[type="text"],
    .form-group input[type="number"],
    .form-group input[type="file"] {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 0.95rem;
    }

    /* Table Styling */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    th, td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #e0e0e0;
    }

    th {
      background-color: #f8f9fa;
      color: #555;
    }

    .btn-delete {
      background-color: #e74c3c;
      color: white;
      border: none;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
      transition: background-color 0.2s;
    }

    .btn-delete:hover {
      background-color: #c0392b;
    }

    /* Drag-and-Drop Slot List */
    .slot-list {
      list-style: none;
      padding: 0;
      margin-top: 15px;
    }

    .slot-item {
      background: #fafafa;
      border: 1px solid #ddd;
      padding: 12px 15px;
      margin-bottom: 8px;
      border-radius: 4px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: move;
      transition: background-color 0.2s;
    }

    .slot-item.dragging {
      opacity: 0.5;
      background: #e3f2fd;
      border-color: #2196f3;
    }

    .drag-handle {
      font-size: 1.2rem;
      color: #888;
      margin-right: 12px;
      user-select: none;
    }

    .quota-input {
      width: 90px !important;
      padding: 6px;
      border: 1px solid #ccc;
      border-radius: 4px;
      text-align: center;
    }

    .btn-primary {
      background-color: #3498db;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
      font-size: 1rem;
      margin-top: 15px;
      transition: background-color 0.2s;
    }

    .btn-primary:hover {
      background-color: #2980b9;
    }

    .image-preview {
      max-height: 60px;
      margin-top: 10px;
      display: block;
      object-fit: contain;
      border-radius: 4px;
      border: 1px solid #ddd;
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <h1>Admin Management Dashboard</h1>
      <a href="/admin/logout" class="btn-logout">Logout</a>
    </header>

    <!-- Active Bookings Table with Deletion & CSV Export -->
    <div class="card">
      <div class="card-header-action">
        <h2>Active Reservations (<%= bookings.length %>)</h2>
        <% if (bookings.length > 0) { %>
          <a href="/admin/bookings/export-csv" class="btn-export">
            ⬇ Export CSV
          </a>
        <% } %>
      </div>

      <% if (bookings.length === 0) { %>
        <p style="color: #777; margin-top: 10px;">No reservations recorded yet.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Time Slot</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(b => { %>
              <tr>
                <td><%= new Date(b.createdAt).toLocaleDateString() %></td>
                <td><strong><%= b.timeSlot %></strong></td>
                <td><%= b.name %></td>
                <td><%= b.email %></td>
                <td><%= b.phone || 'N/A' %></td>
                <td>
                  <form action="/admin/bookings/delete/<%= b._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this reservation entry?');">
                    <button type="submit" class="btn-delete">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- System Settings & Slot Reordering -->
    <div class="card">
      <h2 style="border-bottom: 2px solid #ecf0f1; padding-bottom: 12px; margin-bottom: 15px;">System & Time Slot Settings</h2>
      
      <form action="/admin/settings" method="POST" enctype="multipart/form-data">
        <div class="form-group">
          <label for="title">Event / Site Title:</label>
          <input type="text" id="title" name="title" value="<%= settings.title %>" required>
        </div>

        <div class="form-group">
          <label for="logo">Update Brand Logo:</label>
          <input type="file" id="logo" name="logo" accept="image/*">
          <% if (settings.logoUrl) { %>
            <img src="<%= settings.logoUrl %>" alt="Current Logo" class="image-preview">
          <% } %>
        </div>

        <div class="form-group">
          <label for="bgImage">Update User Page Background Image:</label>
          <input type="file" id="bgImage" name="bgImage" accept="image/*">
          <% if (settings.bgImageUrl) { %>
            <img src="<%= settings.bgImageUrl %>" alt="Current Background Preview" class="image-preview">
          <% } %>
        </div>

        <div class="form-group">
          <label for="defaultQuota">Default Quota Per Time Slot:</label>
          <input type="number" id="defaultQuota" name="defaultQuota" value="<%= settings.defaultQuota %>" min="1" required style="max-width: 200px;">
        </div>

        <h3 style="margin-top: 25px; font-size: 1.1rem; color: #444;">Time Slots & Custom Capacities</h3>
        <p style="color: #666; font-size: 0.9rem; margin-top: 4px;">Drag and drop slots using the ☰ handle to reorder them on the booking page. Optionally set a custom capacity per slot.</p>

        <ul class="slot-list" id="sortableSlotList">
          <% slots.forEach(slot => { %>
            <li class="slot-item" draggable="true" data-slot="<%= slot %>">
              <div style="display: flex; align-items: center;">
                <span class="drag-handle">☰</span>
                <strong><%= slot %></strong>
              </div>
              <div style="display: flex; align-items: center; gap: 8px;">
                <label style="font-size: 0.85rem; color: #555;">Custom Limit:</label>
                <input type="number" name="customQuotas[<%= slot %>]" 
                       value="<%= (settings.customQuotas && settings.customQuotas.has(slot)) ? settings.customQuotas.get(slot) : '' %>" 
                       placeholder="<%= settings.defaultQuota %>" 
                       min="0" class="quota-input">
              </div>
            </li>
          <% }) %>
        </ul>

        <button type="submit" class="btn-primary">Save Settings & Slot Changes</button>
      </form>
    </div>
  </div>

  <script>
    // HTML5 Drag and Drop Script for Reordering Time Slots
    const slotList = document.getElementById('sortableSlotList');
    let draggedItem = null;

    slotList.addEventListener('dragstart', (e) => {
      draggedItem = e.target.closest('.slot-item');
      if (draggedItem) {
        draggedItem.classList.add('dragging');
      }
    });

    slotList.addEventListener('dragend', (e) => {
      if (draggedItem) {
        draggedItem.classList.remove('dragging');
        draggedItem = null;
        saveSlotOrder();
      }
    });

    slotList.addEventListener('dragover', (e) => {
      e.preventDefault();
      const afterElement = getDragAfterElement(slotList, e.clientY);
      if (afterElement == null) {
        slotList.appendChild(draggedItem);
      } else {
        slotList.insertBefore(draggedItem, afterElement);
      }
    });

    function getDragAfterElement(container, y) {
      const draggableElements = [...container.querySelectorAll('.slot-item:not(.dragging)')];
      return draggableElements.reduce((closest, child) => {
        const box = child.getBoundingClientRect();
        const offset = y - box.top - box.height / 2;
        if (offset < 0 && offset > closest.offset) {
          return { offset: offset, element: child };
        } else {
          return closest;
        }
      }, { offset: Number.NEGATIVE_INFINITY }).element;
    }

    async function saveSlotOrder() {
      const orderedSlots = [...slotList.querySelectorAll('.slot-item')].map(item => item.dataset.slot);
      try {
        await fetch('/admin/slots/reorder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderedSlots })
        });
      } catch (err) {
        console.error('Failed to update time slot sequence:', err);
      }
    }
  </script>

</body>
</html>