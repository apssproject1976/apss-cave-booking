        </div>

        <div class="mb-3">
          <label for="phone" class="form-label fw-semibold">Phone Number (Optional)</label>
          <input type="tel" class="form-control" id="phone" name="phone" placeholder="+852 9123 4567">
        </div>

        <div class="mb-4">
          <label for="timeSlot" class="form-label fw-semibold">Select Time Slot</label>
          <select class="form-select" id="timeSlot" name="timeSlot" required>
            <option value="" selected disabled>Choose a session...</option>
            <% slots.forEach(slot => { %>
              <option value="<%= slot %>"><%= slot %></option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Confirm Reservation</button>
      </form>
    </div>
