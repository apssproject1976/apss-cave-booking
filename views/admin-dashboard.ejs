<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - APSS Cave Experience</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  <style>
    body {
      background-color: #f8f9fa;
      padding-top: 30px;
      padding-bottom: 50px;
    }
    .card {
      border: none;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      margin-bottom: 25px;
    }
    .drag-handle {
      cursor: grab;
      color: #6c757d;
    }
    .drag-handle:active {
      cursor: grabbing;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="h3 mb-0">APSS Cave Experience</h1>
        <p class="text-muted mb-0">Admin Management Dashboard</p>
      </div>
      <a href="/view/dashboard" class="btn btn-outline-secondary btn-sm" target="_blank">View Read-Only Mode</a>
    </div>

    <!-- Overview Metrics -->
    <div class="row mb-4">
      <div class="col-md-6">
        <div class="card p-3">
          <div class="text-muted small">Total Active Bookings</div>
          <div class="h2 mb-0 fw-bold"><%= bookings.length %></div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3">
          <div class="text-muted small">Default Slot Capacity</div>
          <div class="h2 mb-0 fw-bold"><%= settings.defaultQuota %> attendees</div>
        </div>
      </div>
    </div>

    <!-- Bookings Table -->
    <div class="card">
      <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0">Manage Reservations</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">#</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Time Slot</th>
                <th>Booking Date</th>
                <th class="text-end pe-3">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (bookings.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">No reservations recorded yet.</td>
                </tr>
              <% } else { %>
                <% bookings.forEach((booking, index) => { %>
                  <tr>
                    <td class="ps-3 text-muted"><%= index + 1 %></td>
                    <td class="fw-semibold"><%= booking.name %></td>
                    <td><%= booking.email %></td>
                    <td><%= booking.phone || '-' %></td>
                    <td><span class="badge bg-primary"><%= booking.timeSlot %></span></td>
                    <td class="text-muted small"><%= new Date(booking.createdAt).toLocaleString() %></td>
                    <td class="text-end pe-3">
                      <form action="/admin/bookings/delete/<%= booking._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this booking?');" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Capacity & Quota Settings Form -->
    <div class="card">
      <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0">Slot Capacity Settings</h5>
      </div>
      <div class="card-body">
        <form action="/admin/settings" method="POST">
          <div class="mb-4 col-md-4">
            <label for="defaultQuota" class="form-label fw-bold">Default Capacity Per Slot</label>
            <input type="number" class="form-control" id="defaultQuota" name="defaultQuota" value="<%= settings.defaultQuota %>" min="1" required>
          </div>

          <h6 class="fw-bold mb-3">Custom Slot Capacity Overrides</h6>
          <div class="row g-3 mb-4">
            <% slots.forEach(slot => { %>
              <div class="col-md-4">
                <label class="form-label small text-muted mb-1"><%= slot %></label>
                <input type="number" class="form-control form-control-sm" name="customQuotas[<%= slot %>]" 
                       value="<%= settings.customQuotas && settings.customQuotas.get ? (settings.customQuotas.get(slot) || '') : '' %>" 
                       placeholder="Default (<%= settings.defaultQuota %>)" min="0">
              </div>
            <% }) %>
          </div>

          <button type="submit" class="btn btn-primary">Save Capacity Settings</button>
        </form>
      </div>
    </div>

    <!-- Drag-and-Drop Slot Reordering -->
    <div class="card">
      <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0">Reorder Time Slots</h5>
        <p class="text-muted small mb-0">Drag and drop sessions to change the order displayed on the booking page.</p>
      </div>
      <div class="card-body">
        <ul id="slotList" class="list-group mb-3">
          <% slots.forEach(slot => { %>
            <li class="list-group-item d-flex align-items-center" data-slot="<%= slot %>">
              <span class="drag-handle me-3">&#x2630;</span>
              <span><%= slot %></span>
            </li>
          <% }) %>
        </ul>
        <button id="saveOrderBtn" class="btn btn-success">Save Slot Order</button>
        <span id="orderMessage" class="ms-3 small"></span>
      </div>
    </div>
  </div>

  <script>
    // Initialize Sortable.js for drag-and-drop reordering
    const slotList = document.getElementById('slotList');
    const sortable = new Sortable(slotList, {
      animation: 150,
      handle: '.drag-handle'
    });

    // Handle AJAX request to save new slot order
    document.getElementById('saveOrderBtn').addEventListener('click', async () => {
      const items = slotList.querySelectorAll('li');
      const orderedSlots = Array.from(items).map(item => item.getAttribute('data-slot'));
      const msgLabel = document.getElementById('orderMessage');

      msgLabel.innerText = 'Saving...';
      msgLabel.className = 'ms-3 small text-muted';

      try {
        const response = await fetch('/admin/slots/reorder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderedSlots })
        });

        if (response.ok) {
          msgLabel.innerText = 'Slot order saved successfully!';
          msgLabel.className = 'ms-3 small text-success';
        } else {
          msgLabel.innerText = 'Failed to save order.';
          msgLabel.className = 'ms-3 small text-danger';
        }
      } catch (err) {
        msgLabel.innerText = 'Error connecting to server.';
        msgLabel.className = 'ms-3 small text-danger';
      }
    });
  </script>
</body>
</html>