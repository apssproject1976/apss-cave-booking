        <% } %>
        <h1 class="h3 fw-bold mb-1"><%= settings.title %></h1>
        <p class="text-muted small">Select an available time slot to reserve your experience</p>
      </div>

      <% if (success && booking) { %>
        <div class="alert alert-success" role="alert">
          <h5 class="alert-heading fw-bold">Booking Confirmed!</h5>
          <p class="mb-0">Thank you, <strong><%= booking.name %></strong>. Your reservation for <strong><%= booking.timeSlot %></strong> is confirmed.</p>
        </div>
      <% } %>

      <form action="/book" method="POST">
        <div class="mb-3">
          <label for="name" class="form-label fw-semibold">Full Name</label>
          <input type="text" class="form-control" id="name" name="name" required placeholder="John Doe">
        </div>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <% if (settings.bgImageUrl) { %>
    <style>
      body {
        background-image: url('<%= settings.bgImageUrl %>');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
      }
    </style>
  <% } %>
</head>
<body>
  <div class="container">
    <header class="header">
      <% if (settings.logoUrl) { %>
        <img src="<%= settings.logoUrl %>" alt="Logo" style="width: <%= settings.logoWidth %>px;" class="logo">
      <% } %>
      <h1><%= settings.title %></h1>
    </header>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>

    <% if (success && booking) { %>
      <div class="alert alert-success">
        <h2>Booking Confirmed!</h2>
        <p><strong>Name:</strong> <%= booking.name %></p>
        <p><strong>Email:</strong> <%= booking.email %></p>
        <p><strong>Time Slot:</strong> <%= booking.timeSlot %></p>
        <a href="/" class="btn">Book Another Session</a>
      </div>
    <% } else { %>
      <form action="/book" method="POST" class="booking-form">
        <div class="form-group">
          <label for="name">Full Name *</label>
          <input type="text" id="name" name="name" required>
        </div>

        <div class="form-group">
          <label for="email">Email Address *</label>
          <input type="email" id="email" name="email" required>
        </div>

        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone">
        </div>

        <div class="form-group">
          <label for="timeSlot">Select Time Slot *</label>
          <select id="timeSlot" name="timeSlot" required>
            <option value="" disabled selected>-- Choose a time slot --</option>
            <% slots.forEach(function(slot) { 
                // Determine capacity: custom quota override vs default quota
                let customQuota;
                if (settings.customQuotas && typeof settings.customQuotas.get === 'function') {
                  customQuota = settings.customQuotas.get(slot);
                } else if (settings.customQuotas) {
                  customQuota = settings.customQuotas[slot];
                }

                const capacity = (customQuota !== undefined && customQuota !== null) 
                  ? customQuota 
                  : settings.defaultQuota;

                const count = (typeof slotCounts !== 'undefined' && slotCounts && slotCounts[slot]) ? slotCounts[slot] : 0;
                const isFull = count >= capacity;
            %>
              <option value="<%= slot %>" <%= isFull ? 'disabled' : '' %>>
                <%= slot %> - <%= isFull ? 'Full' : `Available (${count}/${capacity})` %>
              </option>
            <% }); %>
          </select>
        </div>

        <button type="submit" class="btn">Submit Booking</button>
      </form>
    <% } %>
  </div>
</body>
</html>
