const express = require('express');
const admin = require('firebase-admin');
const bodyParser = require('body-parser');
const path = require('path');
require('dotenv').config();

const app = express();
app.set('view engine', 'ejs');
app.use(bodyParser.urlencoded({ extended: true }));
app.use(bodyParser.json());

// Initialize Firebase Admin SDK
const serviceAccount = require('./firebase-service-account.json');
admin.initializeApp({
  credential: admin.credential.cert(serviceAccount)
});
const db = admin.firestore();

const EVENT_DATE = "2026-10-10";
const TIMESLOTS = [
  "09:30 AM", "10:00 AM", "10:30 AM", "11:00 AM", "11:30 AM",
  "12:00 PM", "12:30 PM", "01:00 PM", "01:30 PM", "02:00 PM",
  "02:30 PM", "03:00 PM", "03:30 PM", "04:00 PM", "04:30 PM"
];

// Helper: Fetch event configuration settings
async function getSettings() {
  const doc = await db.collection('settings').doc('config').get();
  if (!doc.exists) {
    return {
      logoUrl: "https://via.placeholder.com/150",
      title: "APSS Cave Experience",
      subtitle: "Join us for an exclusive journey on 10-Oct-2026"
    };
  }
  return doc.data();
}

// ---------------- USER ROUTES ----------------

// User Booking View
app.get('/', async (req, res) => {
  const settings = await getSettings();
  const snapshot = await db.collection('bookings').get();
  const bookedSlots = snapshot.docs.map(doc => doc.data().timeslot);

  res.render('user', { settings, timeslots: TIMESLOTS, bookedSlots, eventDate: EVENT_DATE, message: null });
});

// Handle User Booking Submission
app.post('/book', async (req, res) => {
  const { name, email, phone, timeslot } = req.body;
  const settings = await getSettings();

  // Check if email already registered
  const emailCheck = await db.collection('bookings').where('email', '==', email).get();
  if (!emailCheck.empty) {
    const snapshot = await db.collection('bookings').get();
    const bookedSlots = snapshot.docs.map(doc => doc.data().timeslot);
    return res.render('user', { 
      settings, timeslots: TIMESLOTS, bookedSlots, eventDate: EVENT_DATE, 
      message: "Error: This email address has already booked a timeslot." 
    });
  }

  // Check if timeslot is already taken
  const slotCheck = await db.collection('bookings').where('timeslot', '==', timeslot).get();
  if (!slotCheck.empty) {
    const snapshot = await db.collection('bookings').get();
    const bookedSlots = snapshot.docs.map(doc => doc.data().timeslot);
    return res.render('user', { 
      settings, timeslots: TIMESLOTS, bookedSlots, eventDate: EVENT_DATE, 
      message: "Error: Selected timeslot is no longer available." 
    });
  }

  // Save Booking
  await db.collection('bookings').add({
    name,
    email,
    phone: phone || 'N/A',
    timeslot,
    createdAt: new Date()
  });

  const snapshot = await db.collection('bookings').get();
  const bookedSlots = snapshot.docs.map(doc => doc.data().timeslot);

  res.render('user', { 
    settings, timeslots: TIMESLOTS, bookedSlots, eventDate: EVENT_DATE, 
    message: "Success! Your booking for " + timeslot + " is confirmed." 
  });
});

// ---------------- ADMIN ROUTES ----------------

// Admin Login Page
app.get('/admin/login', (req, res) => {
  res.render('admin-login', { firebaseApiKey: process.env.FIREBASE_API_KEY });
});

// Admin Dashboard View
app.get('/admin/dashboard', async (req, res) => {
  const settings = await getSettings();
  const snapshot = await db.collection('bookings').get();
  const bookings = snapshot.docs.map(doc => doc.data());

  // Organize bookings by timeslot
  const schedule = TIMESLOTS.map(slot => {
    const booking = bookings.find(b => b.timeslot === slot);
    return {
      timeslot: slot,
      booking: booking ? { name: booking.name, email: booking.email, phone: booking.phone } : null
    };
  });

  res.render('admin-dashboard', { settings, schedule });
});

// Update Site Settings
app.post('/admin/update-settings', async (req, res) => {
  const { logoUrl, title, subtitle } = req.body;
  await db.collection('settings').doc('config').set({ logoUrl, title, subtitle });
  res.redirect('/admin/dashboard');
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Server running on http://localhost:${PORT}`));